    {
      "id": "e69",
      "type": "text",
      "x": 63,
      "y": 1245,
      "width": 1509.3,
      "height": 315.0,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
