    },
    {
      "id": "e64",
      "type": "text",
      "x": 1018,
      "y": 1255,
      "width": 1076.4,
      "height": 405.0,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 1,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Azure RG: capacity, VNet/subnets, NSG, NAT, Bastion/public IPs, VM/NIC/disk,\nFunction/plan, Key Vault, storage/private endpoints/DNS, Fabric Private Link service.\nPerimeters: VM = guest emitter; Fabric = workspace/managed Spark; API = Function/plan.\nAPI storage is separately outlined; Key Vault and the customer VNet are shared dependencies.\nVM extensions observed: AADLoginForWindows and MDE.Windows.\nPowerShell/ARM/Bicep + Fabric REST provision and operate the environment.\nAfter each stress run: drain -> stop owned stream -> OPTIMIZE Events, Scores,\nProcessingAudit and Quarantine. Do not OPTIMIZE the mirrored RawEvents shortcut.\nNo automatic capacity suspension or VM deallocation under the current instruction.",
      "originalText": "Azure RG: capacity, VNet/subnets, NSG, NAT, Bastion/public IPs, VM/NIC/disk,\nFunction/plan, Key Vault, storage/private endpoints/DNS, Fabric Private Link service.\nPerimeters: VM = guest emitter; Fabric = workspace/managed Spark; API = Function/plan.\nAPI storage is separately outlined; Key Vault and the customer VNet are shared dependencies.\nVM extensions observed: AADLoginForWindows and MDE.Windows.\nPowerShell/ARM/Bicep + Fabric REST provision and operate the environment.\nAfter each stress run: drain -> stop owned stream -> OPTIMIZE Events, Scores,\nProcessingAudit and Quarantine. Do not OPTIMIZE the mirrored RawEvents shortcut.\nNo automatic capacity suspension or VM deallocation under the current instruction.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
